# Preserve pinned upstream bytes, including original CRLF line endings.
assets/recipients/paku-paku/upstream/* -text whitespace=cr-at-eol
assets/recipients/jujump/upstream/* -text whitespace=cr-at-eol

# Third-party sources remain available for reproducible builds.
assets/recipients/*/upstream/** linguist-vendored

# Self-contained players bundle compiled JavaScript, styles, and assets.
# Keep recovered component/adapter source visible in language stats and diffs.
assets/transfers/roadster/**/*.html linguist-generated
assets/benchmark/remix-recordings/**/*.html linguist-generated
