FROM node:22-bookworm-slim

RUN groupadd --gid 10001 verifier \
    && useradd --uid 10001 --gid 10001 --home-dir /home/verifier --create-home --shell /usr/sbin/nologin verifier

WORKDIR /app

COPY hosting/constants.mjs hosting/errors.mjs hosting/protocol.mjs hosting/policy.mjs hosting/queue.mjs hosting/publish.mjs hosting/coordinator.mjs hosting/server.mjs hosting/serve.mjs hosting/broker-client.mjs ./hosting/
COPY campaign/phase-budget.mjs ./campaign/phase-budget.mjs
COPY agent/accounting.mjs ./agent/accounting.mjs

USER 10001:10001
EXPOSE 8080
CMD ["node", "hosting/serve.mjs"]
