FROM node:22-bookworm-slim AS creator

WORKDIR /src
COPY package.json package-lock.json ./
COPY scripts/build-creator.mjs ./scripts/build-creator.mjs
COPY web/tsconfig.json ./web/tsconfig.json
COPY web/app ./web/app
COPY web/build.mjs ./web/build.mjs
COPY web/style.css ./web/style.css
RUN npm ci \
    && node scripts/build-creator.mjs /out/creator \
    && test -s /out/creator/index.html

FROM node:22-bookworm-slim

RUN groupadd --gid 10001 verifier \
    && useradd --uid 10001 --gid 10001 --home-dir /home/verifier --create-home --shell /usr/sbin/nologin verifier

WORKDIR /app

COPY src/paths.mjs ./src/paths.mjs
COPY src/hosting/constants.mjs src/hosting/errors.mjs src/hosting/protocol.mjs src/hosting/policy.mjs src/hosting/queue.mjs src/hosting/publish.mjs src/hosting/coordinator.mjs src/hosting/server.mjs src/hosting/serve.mjs src/hosting/broker-client.mjs src/hosting/generation.mjs src/hosting/seed-parent.mjs src/hosting/component-pin.mjs src/hosting/export.mjs ./src/hosting/
COPY src/release/zip.mjs src/release/sha.mjs ./src/release/
COPY src/campaign/phase-budget.mjs ./src/campaign/phase-budget.mjs
COPY src/agent/accounting.mjs src/agent/roadster-request.mjs src/agent/recipient-request.mjs src/agent/meta-client.mjs ./src/agent/
COPY src/parallaxia/replay.mjs ./src/parallaxia/replay.mjs
COPY src/roadster/port.mjs ./src/roadster/port.mjs
COPY assets/components/dashy-dango-dash/component.ts assets/components/dashy-dango-dash/component.js assets/components/dashy-dango-dash/contract.json assets/components/dashy-dango-dash/provenance.json ./assets/components/dashy-dango-dash/
COPY assets/recipients/roadster/recipient.lock.json ./assets/recipients/roadster/recipient.lock.json
COPY assets/recipients/parallaxia/recipient.lock.json ./assets/recipients/parallaxia/recipient.lock.json
COPY --from=creator /out/creator ./web/dist/creator

USER 10001:10001
EXPOSE 8080
CMD ["node", "src/hosting/serve.mjs"]
