FROM node:22-bookworm-slim AS creator

WORKDIR /src
COPY package.json package-lock.json ./
COPY scripts/build-creator.mjs ./scripts/build-creator.mjs
COPY web/tsconfig.json ./web/tsconfig.json
COPY web/app ./web/app
COPY web/build.mjs ./web/build.mjs
COPY web/style.css ./web/style.css
RUN npm ci \
    && node scripts/build-creator.mjs /out/creator \
    && test -s /out/creator/index.html

FROM node:22-bookworm-slim

RUN groupadd --gid 10001 verifier \
    && useradd --uid 10001 --gid 10001 --home-dir /home/verifier --create-home --shell /usr/sbin/nologin verifier

WORKDIR /app

COPY hosting/constants.mjs hosting/errors.mjs hosting/protocol.mjs hosting/policy.mjs hosting/queue.mjs hosting/publish.mjs hosting/coordinator.mjs hosting/server.mjs hosting/serve.mjs hosting/broker-client.mjs hosting/generation.mjs hosting/seed-parent.mjs hosting/component-pin.mjs hosting/export.mjs ./hosting/
COPY release/zip.mjs release/sha.mjs ./release/
COPY campaign/phase-budget.mjs ./campaign/phase-budget.mjs
COPY agent/accounting.mjs agent/roadster-request.mjs agent/recipient-request.mjs agent/meta-client.mjs ./agent/
COPY parallaxia/replay.mjs ./parallaxia/replay.mjs
COPY roadster/port.mjs ./roadster/port.mjs
COPY components/dashy-dango-dash/component.ts components/dashy-dango-dash/component.js components/dashy-dango-dash/contract.json components/dashy-dango-dash/provenance.json ./components/dashy-dango-dash/
COPY recipients/roadster/recipient.lock.json ./recipients/roadster/recipient.lock.json
COPY recipients/parallaxia/recipient.lock.json ./recipients/parallaxia/recipient.lock.json
COPY --from=creator /out/creator ./web/dist/creator

USER 10001:10001
EXPOSE 8080
CMD ["node", "hosting/serve.mjs"]
