{
  "name": "meta-ai-developer-hackathon",
  "version": "0.1.0",
  "private": true,
  "description": "Recover a move from a compiled game, check it, and port it into new games with Meta's models",
  "scripts": {
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint web/app",
    "format": "prettier --write web/app web/style.css web/index.html web/tsconfig.json eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check web/app web/style.css web/index.html web/tsconfig.json eslint.config.mjs .prettierrc.json",
    "dev": "w4 run assets/targets/dashy-dango/cart.wasm --no-qr",
    "dev:transfer": "node scripts/preview.mjs",
    "replay": "node scripts/replay.mjs",
    "investigate": "node scripts/investigate.mjs",
    "recover:motion": "node scripts/recover-motion.mjs",
    "recover:campaign": "node scripts/recovery-campaign.mjs",
    "wonder:harness": "node scripts/wonder-harness.mjs",
    "verify:wonder": "node scripts/verify-wonder-harness.mjs --replay && node scripts/verify-wonder-harness.mjs --v4 && node scripts/verify-wonder-harness.mjs --v5 --replay",
    "recover:muse-code": "node scripts/recover-muse-code.mjs",
    "deliver:recovery": "node scripts/deliver-accepted-recovery.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",
    "transfer:paku": "node scripts/transfer-paku.mjs",
    "verify:transfer": "node scripts/verify-paku-transfer.mjs",
    "verify:jujump": "node scripts/verify-jujump.mjs",
    "export:jujump": "node scripts/export-jujump.mjs",
    "verify:integration": "node scripts/verify-integration.mjs",
    "verify:roadster": "node scripts/verify-roadster.mjs",
    "verify:challenge": "node scripts/verify-challenge.mjs",
    "verify:guided": "node scripts/verify-guided-demo.mjs",
    "benchmark:developer": "node scripts/benchmark-developer.mjs",
    "benchmark:verify": "node scripts/verify-developer-benchmark.mjs",
    "score:candidate": "node scripts/score-candidate.mjs",
    "probe:integration": "node scripts/probe-integration.mjs",
    "compare:transfers": "node scripts/compare-transfers.mjs",
    "tools:smoke": "node scripts/tools-smoke.mjs",
    "tools:session-smoke": "node scripts/investigation-smoke.mjs",
    "tools:experiment-smoke": "node scripts/experiment-smoke.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "build:frontend": "npm run typecheck && node scripts/build-frontend.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "snapshot:site": "node scripts/snapshot-site.mjs",
    "build:release": "node scripts/build-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "smoke:hosted": "node scripts/smoke-hosted.mjs",
    "render:fidelity-media": "node scripts/fidelity-media.mjs",
    "video:candidate": "node scripts/video-candidate.mjs",
    "remix:campaign": "node scripts/remix-campaign.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "record:demo:capture": "node scripts/record-demo.mjs capture",
    "record:demo:render": "node scripts/record-demo.mjs render",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "build:evidence": "node scripts/build-evidence.mjs",
    "auto-port:campaign": "node scripts/auto-port-campaign.mjs",
    "test:auto-port": "node --test --test-concurrency=1 --test-timeout=450000 tests/auto-port.test.mjs tests/port-command.test.mjs tests/footage.test.mjs tests/footage-evidence.test.mjs tests/footage-port.test.mjs tests/open-client.test.mjs tests/intent-reading.test.mjs",
    "port": "node scripts/port.mjs",
    "recover": "node scripts/recover.mjs",
    "verify:hosting": "node --test --test-concurrency=1 tests/hosting.test.mjs",
    "verify:hosting:isolation": "node --test --test-concurrency=1 tests/hosting-isolation.test.mjs",
    "hosting:broker": "node src/hosting/broker-main.mjs",
    "hosting:image": "docker build -f Dockerfile -t motion-transfer-verifier:local .",
    "hosting:coordinator-image": "docker build -f Dockerfile.coordinator -t motion-transfer-coordinator:local .",
    "test:frontend": "node --test --test-concurrency=1 tests/react-frontend.test.mjs tests/experience.test.mjs tests/developer-task.test.mjs tests/developer-benchmark-web.test.mjs tests/experiment-web.test.mjs tests/investigation-web.test.mjs tests/lab-web.test.mjs tests/roadster-experience.test.mjs tests/transfer-preview.test.mjs tests/integration-export.test.mjs tests/recovery-task-web.test.mjs tests/product-release.test.mjs",
    "serve:release": "node scripts/serve-release.mjs",
    "build:creator": "node scripts/build-creator.mjs web/dist/creator",
    "hosting:serve": "node src/hosting/serve.mjs",
    "score:video-comparison": "node scripts/score-video-comparison.mjs",
    "transfer:accepted-roadster": "node scripts/transfer-accepted-roadster.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "crisp-game-lib": "1.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "quickjs-emscripten": "0.32.0",
    "sounds-some-sounds": "3.0.0",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "wabt": "1.0.39",
    "wasm4": "2.7.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
